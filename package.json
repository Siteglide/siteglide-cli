{
	"name": "@siteglide/siteglide-cli",
	"version": "2.0.0",
	"description": "A CLI for Making Website Management a Breeze",
	"scripts": {
		"postinstall": "node ./scripts/check-node-version.js",
		"mcp:i-local": "npm install file:../Siteglide-MCP --no-save",
		"build-assets": "npx webpack-cli gui/editor/src/index.js -o gui/editor/public/app.js --mode=production",
		"build-gui": "npm --prefix gui/next ci && npm --prefix gui/next run build",
		"i": "npm install -g .",
		"test": "jest --silent && node scripts/run-node-tests.js",
		"test:unit": "node scripts/run-node-tests.js",
		"test:integration": "jest --config jest.integration.config.js --silent"
	},
	"main": "./siteglide-cli.js",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/siteglide/siteglide-cli/issues"
	},
	"homepage": "https://docs.siteglide.com/articles/1541403-introduction-to-the-command-line-interface-cli",
	"engines": {
		"node": ">=22.12.0"
	},
	"siteglideMcp": {
		"usage": "siteglide-cli pull offers and installs @siteglide/siteglide-mcp versions satisfying compatibleRange (currently 1.0.0 through 1.1.0). Installs below the range are upgraded via the usual global install prompt; versions above the range get a downgrade warning.",
		"compatibleRange": ">=1.0.0 <=1.1.0"
	},
	"keywords": [
		"Siteglide"
	],
	"dependencies": {
		"@inquirer/prompts": "^8.5.2",
		"@platformos/platformos-check-node": "^1.1.0",
		"archiver": "^5.3.0",
		"archiver-promise": "^1.0.0",
		"async": "^3.2.3",
		"body-parser": "^1.20.8",
		"chalk": "^4.1.2",
		"chokidar": "^5.0.0",
		"commander": "^8.3.0",
		"compression": "^1.8.1",
		"degit": "^2.8.6",
		"email-validator": "^2.0.4",
		"express": "^4.22.3",
		"fs-extra": "^10.0.1",
		"js-yaml": "^4.3.2",
		"livereload": "^0.10.3",
		"mime-types": "^2.1.35",
		"minimist": "^1.2.6",
		"mustache": "^4.2.0",
		"node-fetch": "^2.6.7",
		"node-notifier": "^10.0.1",
		"node-stream-zip": "^1.15.0",
		"open": "^8.4.0",
		"ora": "^5.4.1",
		"semver": "^7.8.5",
		"sharp": "^0.35.3",
		"shelljs": "^0.8.5",
		"tinyglobby": "^0.2.17",
		"update-notifier": "^7.3.1",
		"uuid": "11.1.1",
		"valid-url": "^1.0.9",
		"webpack-cli": "6.0.1"
	},
	"devDependencies": {
		"jest": "^30.5.1"
	},
	"bin": {
		"siteglide-cli": "./siteglide-cli.js",
		"siteglide-cli-add": "./siteglide-cli-add.js",
		"siteglide-cli-ai": "./siteglide-cli-ai.js",
		"siteglide-cli-archive": "./siteglide-cli-archive.js",
		"siteglide-cli-check": "./siteglide-cli-check.js",
		"siteglide-cli-deploy": "./siteglide-cli-deploy.js",
		"siteglide-cli-export": "./siteglide-cli-export.js",
		"siteglide-cli-gui": "./siteglide-cli-gui.js",
		"siteglide-cli-import": "./siteglide-cli-import.js",
		"siteglide-cli-init": "./siteglide-cli-init.js",
		"siteglide-cli-list": "./siteglide-cli-list.js",
		"siteglide-cli-logs": "./siteglide-cli-logs.js",
		"siteglide-cli-mcp": "./siteglide-cli-mcp.js",
		"siteglide-cli-modules": "./siteglide-cli-modules.js",
		"siteglide-cli-pull": "./siteglide-cli-pull.js",
		"siteglide-cli-push": "./siteglide-cli-push.js",
		"siteglide-cli-server": "./siteglide-cli-server.js",
		"siteglide-cli-sync": "./siteglide-cli-sync.js",
		"siteglide-cli-watch": "./siteglide-cli-watch.js"
	},
	"preferGlobal": true,
	"repository": "siteglide/siteglide-cli",
	"overrides": {
		"uuid": "$uuid",
		"qs": "^6.16.0",
		"json-schema": "^0.4.0",
		"tough-cookie": "^4.1.4",
		"ansi-regex": "^5.0.1",
		"minimatch": "^3.1.4",
		"brace-expansion": "^1.1.18",
		"cross-spawn": "^7.0.6",
		"ws": "^8.18.0",
		"archiver-promise": {
			"async": "^3.2.6"
		},
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^4.3.2"
		}
	}
}
