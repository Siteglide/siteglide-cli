{
	"name": "@siteglide/siteglide-cli",
	"version": "1.10.3",
	"description": "A CLI for Making Website Management a Breeze",
	"scripts": {
		"postinstall": "node ./scripts/check-node-version.js",
		"install:mcp": "npm install file:../Siteglide-MCP --no-save",
		"build-assets": "npx webpack-cli gui/editor/src/index.js -o gui/editor/public/app.js --mode=production",
		"build-gui": "npm --prefix gui/next ci && npm --prefix gui/next run build",
		"i": "npm install -g ."
	},
	"main": "./siteglide-cli.js",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/siteglide/siteglide-cli/issues"
	},
	"homepage": "https://developers.siteglide.com/introducing-siteglide-cli",
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"Siteglide"
	],
	"dependencies": {
